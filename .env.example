# ==============================================================================
# GFG RAG Assistant - Environment Configuration Template
# COPY THIS FILE TO '.env' AND FILL IN YOUR ACTUAL KEYS. NEVER COMMIT '.env'!
# ==============================================================================

# Application Environment (development / production)
APP_ENV=development
PRIMARY_PROVIDER=groq

# ChromaDB Cloud Configuration (3.4 Lakh Indexed GFG Chunks)
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=f98bf1bd-b7ed-4d64-90a8-9c4be572e360
CHROMA_DATABASE=gfg_rag
CHROMA_COLLECTION=articles

# Primary LLM: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
PRIMARY_LLM_MODEL=gemini-3.8-flash

# Fallback LLM: Groq LPU (Bypasses 429/503 Spikes)
GROQ_API_KEY=your_groq_api_key_here
FALLBACK_LLM_MODEL=openai/gpt-oss-120b

# Server Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=*
